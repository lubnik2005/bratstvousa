########################################################################
# PRODUCTION ENV TEMPLATE for admin.bratstvousa.org (Linode + Docker)
#
# Copy to `.env` on the server (or supply via docker compose env_file) and
# fill in the SECRET values. Do NOT commit the filled-in file.
#
# Architecture:
#   - Nova plumbing (users/roles/permissions/audits/sessions/cache/jobs)
#     lives in a local SQLite file: database/plumbing.sqlite (default conn).
#   - Content resources (events, churches, news, media, form submissions)
#     are pinned to the Cloudflare D1 connection via `protected $connection`.
#   - Media files are stored on Cloudflare R2 (S3-compatible) disk.
########################################################################

APP_NAME="Bratstvo Admin"
APP_ENV=production
# Generate once with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://admin.bratstvousa.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: stderr so Docker captures logs; info level in prod.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

########################################################################
# DATABASE
########################################################################
# Default connection = local "plumbing" SQLite. Path points at the
# container volume mount so data survives redeploys.
DB_CONNECTION=plumbing
PLUMBING_DB_DATABASE=/var/www/html/database/plumbing.sqlite
DB_FOREIGN_KEYS=true

# Cloudflare D1 (shared content DB, owned by SvelteKit Drizzle schema).
CLOUDFLARE_ACCOUNT_ID=6a3f948e78f0950634401234e9f7a543
CLOUDFLARE_D1_DATABASE_ID=fdf9adc7-0fa2-420e-b492-64b497e740c9
# SECRET - Cloudflare API token with D1 Read+Write. ROTATE post-launch.
CLOUDFLARE_TOKEN=
CLOUDFLARE_D1_API=https://api.cloudflare.com/client/v4

# Zeffy API key used by the hourly `zeffy:sync` reconciliation command.
# SECRET - never commit the value.
ZEFFY_API_KEY=

########################################################################
# SESSION / CACHE / QUEUE  (file / file / sync - no redis, no DB-backed)
########################################################################
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null so the cookie binds to the exact host. Set to
# .bratstvousa.org only if you need cross-subdomain sessions.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

########################################################################
# FILESYSTEM / MEDIA  ->  Cloudflare R2 (S3-compatible)
########################################################################
FILESYSTEM_DISK=s3
MEDIA_DISK=s3

# With sync queue, run image conversions inline. Disable the
# after-commit deferral because l1's D1 driver has no real transactions.
QUEUE_CONVERSIONS_BY_DEFAULT=false
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=false

# R2 S3 API. The "s3" disk in config/filesystems.php reads these AWS_* vars.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=bratstvousa-media
AWS_ENDPOINT=https://6a3f948e78f0950634401234e9f7a543.r2.cloudflarestorage.com
# Public URL base for stored media. Must match the SvelteKit frontend's
# MEDIA_URL (app/wrangler.toml) so Nova's Image fields resolve the same
# files the public site serves. R2 custom domain on the bratstvousa.com zone.
AWS_URL=https://media.bratstvousa.com
# R2 requires path-style addressing.
AWS_USE_PATH_STYLE_ENDPOINT=true

########################################################################
# MAIL  (Resend transactional email — used for Nova password resets)
########################################################################
# The sending domain (e.g. bratstvousa.com) MUST be verified in Resend,
# otherwise the API rejects sends with 403/422.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@bratstvousa.com"
MAIL_FROM_NAME="${APP_NAME}"

########################################################################
# NOVA
########################################################################
# Runtime license key (distinct from the Composer download API key).
NOVA_LICENSE_KEY=

# Password-reset broker for Nova's forgot-password flow.
# Must match a key under config/auth.php 'passwords' (default: users).
NOVA_PASSWORDS=users

########################################################################
# ADMIN SEED  (consumed by AdminUserSeeder on first boot)
########################################################################
ADMIN_EMAIL=admin@bratstvousa.org
ADMIN_NAME=Administrator
# SECRET - set a strong password before first boot.
ADMIN_PASSWORD=
