{
	"name": "camp-paradise-web",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev",
		"deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name camp-paradise-web --branch main --commit-dirty=true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"assets": "bash scripts/fetch-assets.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.7.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.12.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"svelte": "^5.2.11",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.0.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.1.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.1.0",
		"@threlte/core": "^8.0.0",
		"@threlte/extras": "^9.0.0",
		"bootstrap-icons": "^1.13.1",
		"gsap": "^3.12.5",
		"three": "^0.171.0"
	}
}
