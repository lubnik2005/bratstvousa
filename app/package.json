{
	"name": "app",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply bratstvousa-db --local",
		"db:migrate:prod": "wrangler d1 migrations apply bratstvousa-db --remote",
		"db:studio": "drizzle-kit studio",
		"dev": "vite dev",
		"dev:remote": "DEV_REMOTE=true vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"preview": "wrangler pages dev",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261022.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@playwright/test": "^1.45.3",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/leaflet": "^1.9.22",
		"autoprefixer": "^10.4.20",
		"better-sqlite3": "^13.0.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^15.0.0",
		"mdsvex": "^0.11.2",
		"postcss": "^8.5.23",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass-embedded": "^1.83.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.3.4",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@editorjs/editorjs": "^2.30.8",
		"@fullcalendar/bootstrap5": "^6.1.15",
		"@fullcalendar/core": "^6.1.15",
		"@fullcalendar/daygrid": "^6.1.15",
		"@fullcalendar/interaction": "^6.1.15",
		"@fullcalendar/list": "^6.1.15",
		"@fullcalendar/timegrid": "^6.1.15",
		"@fullcalendar/web-component": "^6.1.15",
		"@noble/hashes": "^2.2.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@splidejs/svelte-splide": "^0.2.9",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltestrap/sveltestrap": "^6.2.7",
		"bootstrap": "^5.3.3",
		"drizzle-orm": "^0.45.4",
		"editorjs-html": "^4.0.5",
		"glightbox": "^3.3.0",
		"json-schema-to-ts": "^3.1.1",
		"leaflet": "^1.9.4",
		"svelte-carousel": "^1.0.25",
		"ts-algebra": "^2.0.0"
	}
}
