# Cloudflare Pages Environment
# These are set in Cloudflare Pages dashboard, not in .env for production.
# This file is for local development reference only.

# Media URL (R2 public bucket or CDN)
# Used for serving images, videos, and other media files
# Must match the R2 public URL used by the admin panel (AWS_URL).
MEDIA_URL="https://media.bratstvousa.com/"

# Admin Panel URL
# URL to your Laravel Nova admin panel
ADMIN_URL="https://admin.example.com"

# Resend API key (for sending emails).
# Uses the same verified sending domain (bratstvousa.com) as the admin panel.
RESEND_API_KEY=""

# From-address for outbound email (must be on a Resend-verified domain).
MAIL_FROM="noreply@bratstvousa.com"
MAIL_FROM_NAME="Bratstvo USA"

# Email Recipient for Form Submissions
MAIL_INFO_USER="info@bratstvousa.org"

# Zeffy payment link for approved camp registrations.
# Approved registrants are sent here and enter their CAMP-XXXXX code at checkout.
ZEFFY_URL=""
