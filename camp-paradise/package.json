{
	"name": "camp-paradise",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply camp-paradise-db --local",
		"db:migrate:prod": "wrangler d1 migrations apply camp-paradise-db --remote",
		"db:studio": "drizzle-kit studio",
		"dev": "vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"preview": "wrangler pages dev",
		"test:unit": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261022.1",
		"better-sqlite3": "^13.0.2",
		"@types/better-sqlite3": "^9.6.0",
		"vitest": "^4.1.12",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"autoprefixer": "^10.4.20",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^15.0.0",
		"postcss": "^8.5.31",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.4.5",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"bootstrap-icons": "^1.13.1",
		"drizzle-orm": "^0.45.4"
	}
}
